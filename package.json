{
  "name": "bassir-owner-eyes",
  "version": "1.0.0",
  "description": "نظام بصير - عيون المالك | Bassir Owner Eyes: منصة رؤية بصرية لربط المالك بالاستشاري والمقاول",
  "main": "server/server.js",
  "scripts": {
    "start": "node --no-warnings server/server.js",
    "seed": "node server/seed.js --reset",
    "build:demo": "node tools/build-demo.js",
    "preflight": "node tools/preflight.js",
    "test": "node tests/api-integration.js && node tests/roles-smoke.js && node tests/e2e-cycle.js && node tests/drawing-boq-brightness.js && node tests/bim-render.js",
    "test:smoke": "node tests/roles-smoke.js",
    "test:crawl": "node tests/crawl-all.js",
    "test:brightness": "node tests/drawing-boq-brightness.js",
    "test:cycle": "node tests/e2e-cycle.js",
    "test:bim": "node tests/bim-render.js",
    "gen:ifc": "node tests/gen-ifc.js",
    "test:full": "npm test && node tests/crawl-all.js",
    "test:api": "node tests/api-integration.js"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.112.0"
  },
  "license": "MIT",
  "dependencies": {
    "arabic-reshaper": "^1.1.0",
    "pdfjs-dist": "^6.1.200",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
