# بصير - عيون المالك | إعدادات الخدمات الحقيقية
# انسخ هذا الملف إلى .env واملأ القيم — أي خدمة غير مهيأة تعمل بوضع المحاكاة

# ============ التخزين ============
# sqlite (الافتراضي - قاعدة بيانات حقيقية مدمجة) أو json
STORAGE=sqlite

# سر توقيع التوكنات في الإنتاج (وإلا يُولَّد ويُحفَظ تلقائياً في data/.jwt-secret)
# JWT_SECRET=

# ============ الذكاء الاصطناعي (تحليل صور الموقع والكاميرات) ============
# يتطلب: npm install @anthropic-ai/sdk
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# ============ البريد الإلكتروني (اختر مزوداً واحداً) ============
# RESEND_API_KEY=re_...
# SENDGRID_API_KEY=SG...
# EMAIL_FROM=Bassir <reports@yourdomain.com>

# ============ واتساب (Meta WhatsApp Cloud API) ============
# من https://business.facebook.com > WhatsApp > API Setup
# WHATSAPP_TOKEN=EAAG...
# WHATSAPP_PHONE_ID=1234567890
# WHATSAPP_COUNTRY_CODE=966

# ============ مدخل لقطات الكاميرات ============
# مفتاح تستخدمه الكاميرا/NVR لدفع اللقطات:
# curl -X POST /api/cameras/CAM1/snapshot -H "x-camera-key: $CAMERA_KEY" --data-binary @snap.jpg
# CAMERA_KEY=

# PORT=3000
